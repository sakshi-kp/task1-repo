pipeline {
    agent any
    
    tools {
        jdk 'java-11'
        maven 'maven'
    }
    
    stages {
        stage('git-checkout') {
            steps {
                git branch: 'task-2', url: 'https://github.com/sakshi-kp/task1-repo.git'
            }
        }
        
        stage('compile') {
            steps {
                sh "mvn compile"
            }
        }
        
        stage('Build') {
            steps {
                sh "mvn clean install"
            }
        }
    }
}
